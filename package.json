{
  "name": "ctr-mod-manager",
  "productName": "CtrModManager",
  "version": "1.0.0",
  "description": "A clean Thunderstore mod manager for desktop.",
  "author": "AraoPU2",
  "private": true,
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AraoPU/CtrModManager.git"
  },
  "bugs": {
    "url": "https://github.com/AraoPU/CtrModManager/issues"
  },
  "homepage": "https://github.com/AraoPU/CtrModManager#readme",
  "config": {
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "js-yaml": "^5.5.0"
  },
  "build": {
    "appId": "com.ctrmodmanager.app",
    "productName": "CtrModManager",
    "copyright": "Copyright © 2026 Ar Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CtrModManager-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CtrModManager",
      "artifactName": "CtrModManager-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
